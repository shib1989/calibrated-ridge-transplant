<mxfile host="app.diagrams.net"><diagram name="Method overview" id="m1"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="714" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="grp" value="For each anchor subset" style="rounded=1;arcSize=4;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#C26A00;strokeWidth=1.5;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#C26A00;" vertex="1" parent="1"><mxGeometry x="262" y="256" width="747" height="231" as="geometry"/></mxCell><mxCell id="M" value="&lt;b&gt;Models&lt;/b&gt;&lt;br&gt;Donor D: embeddings E_d&lt;br&gt;Receiver R: embeddings E_r" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#5B7C99;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="220" height="165" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;Anchors&lt;/b&gt;&lt;br&gt;shared tokens (whole&lt;br&gt;words in expansion)&lt;br&gt;X: n × d_d,  Y: n × d_r" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#5B7C99;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="275" y="24" width="220" height="165" as="geometry"/></mxCell><mxCell id="S1" value="&lt;b&gt;① Centre (all anchors)&lt;/b&gt;&lt;br&gt;μ_d, μ_r, mean norm r̄&lt;br&gt;X_c = X − μ_d&lt;br&gt;Y_c = Y − μ_r" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#2B6CA3;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="526" y="24" width="220" height="165" as="geometry"/></mxCell><mxCell id="S2" value="&lt;b&gt;② Two anchor subsets&lt;/b&gt;&lt;br&gt;all anchors&lt;br&gt;5000 most frequent in&lt;br&gt;the training text" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#2B6CA3;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="777" y="24" width="220" height="165" as="geometry"/></mxCell><mxCell id="S3" value="&lt;b&gt;③ Scale and fit one global map&lt;/b&gt;&lt;br&gt;X̃ = X_c / s (per subset)&lt;br&gt;λ by held-out cosine&lt;br&gt;W: ridge fit, Eq. (1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE9C9;strokeColor=#C26A00;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="777" y="306" width="220" height="165" as="geometry"/></mxCell><mxCell id="S4" value="&lt;b&gt;④ Direction of x*&lt;/b&gt;&lt;br&gt;x*: donor embedding&lt;br&gt;u* = unit((x*−μ_d)/s·W)&lt;br&gt;keeps the direction only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE9C9;strokeColor=#C26A00;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="526" y="306" width="220" height="165" as="geometry"/></mxCell><mxCell id="S5" value="&lt;b&gt;⑤ Calibrated length&lt;/b&gt;&lt;br&gt;ŷ* = μ_r + c·r̄·u*&lt;br&gt;c from a grid, by NLL&lt;br&gt;on training text" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE9C9;strokeColor=#C26A00;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="275" y="306" width="220" height="165" as="geometry"/></mxCell><mxCell id="S6" value="&lt;b&gt;⑥ Select variant&lt;/b&gt;&lt;br&gt;subset with the lower&lt;br&gt;training objective&lt;br&gt;is kept (ridge[sel])" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#2B6CA3;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="24" y="306" width="220" height="165" as="geometry"/></mxCell><mxCell id="O" value="&lt;b&gt;⑦ New rows and test&lt;/b&gt;&lt;br&gt;one row per new token&lt;br&gt;old rows unchanged&lt;br&gt;NLL: zero-shot, 200 steps" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DDF0E1;strokeColor=#2E7D4F;strokeWidth=1.5;fontSize=11;fontColor=#1f2933;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="24" y="542" width="220" height="165" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="M" target="A"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="A" target="S1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="S2" target="S3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="S3" target="S4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="S4" target="S5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="S5" target="S6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;" edge="1" parent="1" source="S6" target="O"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>